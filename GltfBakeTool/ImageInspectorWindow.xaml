<Window x:Class="GltfBakeTool.ImageInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image" Height="800" Width="1000" WindowStartupLocation="CenterOwner"
        Background="#FF2B2B2B">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Fit" Click="Fit_Click" Padding="8,2" ToolTip="Fit image to window (F)"/>
            <Button Content="1:1" Click="Actual_Click" Padding="8,2" ToolTip="Actual pixels (1)"/>
            <Separator/>
            <CheckBox x:Name="ChkPixelated" Content="Pixel-exact when zoomed in" IsChecked="True" VerticalAlignment="Center" Margin="4,0"
                      Checked="Pixelated_Changed" Unchecked="Pixelated_Changed"/>
            <CheckBox x:Name="ChkChecker" Content="Checkerboard" IsChecked="True" VerticalAlignment="Center" Margin="4,0"
                      Checked="Checker_Changed" Unchecked="Checker_Changed"/>
            <Separator/>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="6,0" Foreground="Black"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Mouse wheel: zoom · left drag: pan · double-click: fit"/>
        </StatusBar>
        <!-- Viewport: clips the transformed image -->
        <Canvas x:Name="Viewport" ClipToBounds="True" Background="Transparent"
                MouseWheel="Viewport_MouseWheel"
                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                MouseMove="Viewport_MouseMove"
                SizeChanged="Viewport_SizeChanged"
                Focusable="True">
            <Grid x:Name="ImageLayer">
                <Rectangle x:Name="Checker">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#FF808080"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
                                    <GeometryDrawing Brush="#FFA0A0A0"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry></GeometryDrawing>
                                    <GeometryDrawing Brush="#FFA0A0A0"><GeometryDrawing.Geometry><RectangleGeometry Rect="8,8,8,8"/></GeometryDrawing.Geometry></GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Image x:Name="Img" Stretch="Fill"/>
            </Grid>
        </Canvas>
    </DockPanel>
</Window>
