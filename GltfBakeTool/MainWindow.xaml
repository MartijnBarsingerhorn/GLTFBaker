<Window x:Class="GltfBakeTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:vm="clr-namespace:GltfBakeTool.ViewModels"
        Title="{Binding Title}" Height="800" Width="1300"
        AllowDrop="True" Drop="Window_Drop">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open…" Command="{Binding OpenCommand}" Padding="8,2"/>
            <Button Content="Save As…" Command="{Binding SaveAsCommand}" Padding="8,2"/>
            <Separator/>
            <Button Content="Undo" Command="{Binding UndoCommand}" Padding="8,2"/>
            <Separator/>
            <Button Content="Clean empty nodes" Command="{Binding CleanEmptyCommand}" Padding="8,2" ToolTip="Removes empty container nodes (whole file, or only the checked subtrees)"/>
            <CheckBox Content="Fold transforms" IsChecked="{Binding FoldTransforms}" VerticalAlignment="Center" Margin="4,0" ToolTip="Also remove empties with a non-identity transform by folding it into their children"/>
            <Separator/>
            <TextBlock Text="Atlas:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox ItemsSource="{Binding AtlasSizes}" SelectedItem="{Binding AtlasSize}" Width="70" ToolTip="Maximum atlas size (px)"/>
            <TextBlock Text="pad" VerticalAlignment="Center" Margin="6,0,2,0"/>
            <TextBox Text="{Binding AtlasPadding, UpdateSourceTrigger=PropertyChanged}" Width="30" ToolTip="Padding in pixels around each atlas cell"/>
            <TextBlock Text="max repeats" VerticalAlignment="Center" Margin="6,0,2,0"/>
            <TextBox Text="{Binding MaxTileRepeats, UpdateSourceTrigger=PropertyChanged}" Width="30" ToolTip="UV tiling up to this many repeats is baked; beyond it UVs are clamped (with a warning)"/>
            <CheckBox Content="JPEG colour" IsChecked="{Binding JpegColor}" VerticalAlignment="Center" Margin="6,0" ToolTip="Encode base colour / emissive atlas as JPEG when no alpha is needed"/>
            <TextBlock Text="alpha" VerticalAlignment="Center" Margin="6,0,2,0"/>
            <ComboBox ItemsSource="{Binding AlphaPolicies}" SelectedItem="{Binding AlphaPolicy}" Width="72"
                      ToolTip="Alpha mode of the merged material: Auto = most permissive of the sources (Blend > Mask > Opaque)"/>
            <TextBox Text="{Binding AlphaCutoff, UpdateSourceTrigger=PropertyChanged}" Width="34" ToolTip="Alpha cutoff (only used for Mask)"/>
            <TextBlock Text="name" VerticalAlignment="Center" Margin="6,0,2,0"/>
            <TextBox Text="{Binding JoinName, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
            <Button Content="Join checked" Command="{Binding JoinCommand}" Padding="8,2" FontWeight="Bold" ToolTip="Merge all meshes under the checked nodes into one primitive with one atlased material"/>
            <Separator/>
            <Button Content="Zoom extents" Click="ZoomExtents_Click" Padding="8,2"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}"/>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Node tree + join groups -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="260" MinHeight="120"/>
                </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Text="Scene nodes" FontWeight="Bold" Margin="6,4"/>
                <TreeView x:Name="NodeTree" ItemsSource="{Binding RootNodes}" SelectedItemChanged="NodeTree_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:NodeItem}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"
                                        Background="{Binding GroupBrush}" ToolTip="{Binding GroupToolTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GroupBrush}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemovableEmpty}" Value="True">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Kind, StringFormat=' [{0}]'}" Foreground="DarkGray" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="Join groups" FontWeight="Bold" Margin="6,4"
                           ToolTip="Primitives are grouped by properties one merged material cannot express per part. Click a group to check its nodes."/>
                <WrapPanel DockPanel.Dock="Top" Margin="4,0,4,2">
                    <WrapPanel.Resources>
                        <Style TargetType="CheckBox">
                            <Setter Property="Margin" Value="0,0,8,2"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </WrapPanel.Resources>
                    <CheckBox Content="blend" IsChecked="{Binding SplitBlend}" ToolTip="Blended materials in their own group"/>
                    <CheckBox Content="mask≠opaque" IsChecked="{Binding SplitMaskFromOpaque}" ToolTip="Also keep MASK apart from OPAQUE"/>
                    <CheckBox Content="unlit" IsChecked="{Binding SplitUnlit}"/>
                    <CheckBox Content="transmission" IsChecked="{Binding SplitTransmission}" ToolTip="KHR_materials_transmission / volume (glass)"/>
                    <CheckBox Content="clearcoat" IsChecked="{Binding SplitClearcoat}" ToolTip="KHR_materials_clearcoat (car paint)"/>
                    <CheckBox Content="other ext" IsChecked="{Binding SplitOtherExtensions}" ToolTip="Sheen, specular, iridescence, anisotropy, IOR"/>
                    <CheckBox Content="uv1+" IsChecked="{Binding SplitUvSet}" ToolTip="Textures on TEXCOORD_1 or higher (cannot be atlased)"/>
                    <CheckBox Content="tiled" IsChecked="{Binding SplitHighTiling}" ToolTip="UV tiling above 'max repeats' (would be clamped)"/>
                    <CheckBox Content="2-sided" IsChecked="{Binding SplitDoubleSided}"/>
                    <CheckBox Content="colour viewport by group" IsChecked="{Binding ColorByGroup}" FontWeight="SemiBold"/>
                </WrapPanel>
                <ListBox ItemsSource="{Binding Groups}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="GroupList_MouseDoubleClick" SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="GroupItem_Click"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Counts}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <!-- Viewport -->
            <hx:Viewport3DX Grid.Column="2" x:Name="Viewport"
                            BackgroundColor="#FF3A3A3A"
                            ShowCoordinateSystem="True" ShowViewCube="True"
                            ZoomExtentsWhenLoaded="True"
                            MSAA="Four"
                            IsShadowMappingEnabled="False">
                <hx:Viewport3DX.InputBindings>
                    <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="LeftClick"/>
                    <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="MiddleClick"/>
                    <MouseBinding Command="hx:ViewportCommands.Zoom" Gesture="RightClick"/>
                </hx:Viewport3DX.InputBindings>
            </hx:Viewport3DX>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>

            <!-- Properties + log -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="Bold" Margin="6,4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBox x:Name="PropsBox" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="Consolas" Margin="4" BorderThickness="0"/>
                            <ItemsControl ItemsSource="{Binding TexturePreviews}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Info}" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                                            <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" Margin="0,2"
                                                    Cursor="Hand" ToolTip="Double-click to inspect at full resolution"
                                                    MouseLeftButtonDown="Preview_MouseLeftButtonDown">
                                                <Image Source="{Binding Image}" Width="256" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                <GridSplitter Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="Bold" Margin="6,4"/>
                    <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
